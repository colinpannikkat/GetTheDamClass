{
  // The same strict settings the extension gets from WXT.
  "compilerOptions": {
    "target": "ES2024",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    // Only the Workers runtime's own globals (Request, Response, ...), not the
    // browser's or Node's. They come from `.cloudflare/types`, which
    // `cf workers types` writes (the typecheck script runs it first).
    "lib": ["ES2024"],
    "types": [],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "*.config.ts", ".cloudflare/types"]
}
